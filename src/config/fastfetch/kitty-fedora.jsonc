{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "break",
    "break",
    "break",
    "break",
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "#6394BF",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "#6394BF"
    },
    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "#6394BF"
    },
    "break",
    "break",
    {
      "type": "host",
      "format": "{5} {1} Type {2}",
      "key": "PC   ",
      "keyColor": "#6394BF"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7}",
      "key": " ├  ",
      "keyColor": "#6394BF"
      // "outputColor": "#ed1c24"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": " ├ 󰢮 ",
      "keyColor": "#6394BF"
      // "outputColor": "#76b900"
    },
    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "#6394BF",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " └ 󰋊 ",
      "keyColor": "#6394BF",
      "format": "{size-used} / {size-total}"
    }
  ]
}
