{
  "name": "@afcms/shell-config",
  "version": "0.0.5",
  "description": "AFCMS interactive shell configuration installer",
  "keywords": [
    "cli",
    "config",
    "installer",
    "interactive",
    "shell"
  ],
  "homepage": "https://github.com/AFCMS/shell-config#readme",
  "bugs": {
    "url": "https://github.com/AFCMS/shell-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "AFCMS",
    "email": "afcm.contact@gmail.com",
    "url": "https://afcms.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/shell-config.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/AFCMS"
    }
  ],
  "bin": {
    "shell-config": "./dist/shell-config.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:npm && pnpm run build:sea",
    "dev": "node --import @oxc-node/core/register src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:check": "oxlint --type-check",
    "prepare": "husky",
    "build:npm": "tsdown && node scripts/write-schema.ts && pnpm --config.ignore-scripts=true pack --pack-destination build/npm",
    "build:sea": "tsdown --config tsdown.sea.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cac": "^7.1.1",
    "jsonc-parser": "4.0.0-next.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@oxc-node/core": "^1.0.3",
    "@tsdown/exe": "^0.23.7",
    "@types/node": "^26.6.11",
    "@vitest/ui": "^5.1.2",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "engineStrict": true
}
