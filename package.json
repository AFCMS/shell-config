{
  "name": "@afcms/shell-config",
  "version": "0.0.0",
  "description": "AFCMS interactive shell configuration installer",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/shell-config.git"
  },
  "bin": {
    "shell-config": "./dist/shell-config.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:npm && pnpm run build:sea",
    "dev": "node --import @oxc-node/core/register src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:check": "oxlint --type-check",
    "prepare": "husky",
    "build:npm": "tsdown && node scripts/write-schema.ts && pnpm --config.ignore-scripts=true pack --pack-destination build/npm",
    "build:sea": "tsdown --config tsdown.sea.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "cac": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@oxc-node/core": "^1.0.2",
    "@tsdown/exe": "^0.23.7",
    "@types/node": "^26.6.6",
    "@vitest/ui": "^5.1.1",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  },
  "engineStrict": true
}
