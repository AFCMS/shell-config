{
  "tasks": {
    "dev": "deno run --watch main.ts",
    "build": "deno compile -P --output build/shell-config main.ts",
    "build:linux-x64": "deno compile -P --frozen --target x86_64-unknown-linux-gnu --output build/shell-config-linux-x64 main.ts",
    "build:linux-arm64": "deno compile -P --frozen --target aarch64-unknown-linux-gnu --output build/shell-config-linux-arm64 main.ts",
    "build:windows-x64": "deno compile -P --frozen --target x86_64-pc-windows-msvc --output build/shell-config-windows-x64.exe main.ts"
  },
  "imports": {
    "@clack/prompts": "npm:@clack/prompts@^1.2.0",
    "@std/assert": "jsr:@std/assert@1"
  },
  "permissions": {
    "default": {
      // "read": ["/etc/debian_version", "/etc/redhat-release", "<TMP>"],
      // "run": ["zsh", "which", "dnf", "apt"]
      // Deno resolve full paths at compile time and doesn't support wildcards.
      // it sounds good until you want to support multiple distro with different paths or user folders
      // https://github.com/denoland/deno/issues/30740
      "read": true,
      "write": true,
      "run": true,
      // "env": ["HOME", "USER", "ZSH", "SUDO_USER"],
      "env": true,
      "net": ["raw.githubusercontent.com", "starship.rs"]
    }
  }
}
